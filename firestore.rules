rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure access control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Every user has their own private isolated tree under /users/{userId}
    match /users/{userId} {
      // User profile document
      allow read, write: if isOwner(userId);

      // Subcollections: accounts, transactions, bills, subscriptions, budgets,
      // goals, cashReconciliations, worthItItems, dailyLogs, insights
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
